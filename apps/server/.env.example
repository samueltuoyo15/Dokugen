# Server Configuration
PORT=3000
NODE_ENV=production
BACKEND_DOMAIN=http://localhost:3000

# AI Provider Configuration (OpenAI SDK Compatible)
# Works with ApiSmart, OpenRouter, OpenAI, DeepSeek, etc.
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://gw.apismart.ai/v1
README_MODEL_NAME=kimi-k2.7-code
COMMIT_MODEL_NAME=glm-5-turbo
OG_MODEL_NAME=glm-5-turbo
CHANGELOG_MODEL_NAME=glm-5-turbo

# Supabase Persistence & User Telemetry Tracking (Optional)
SUPABASE_CLIENT_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Advanced: Google Vertex AI Setup
# If using Vertex AI instead of an API key, leave OPENAI_API_KEY blank, point OPENAI_BASE_URL to your Vertex endpoint, and provide the service account JSON.
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# OPENAI_BASE_URL=https://aiplatform.googleapis.com/v1/projects/your-google-cloud-project/locations/global/endpoints/openapi
