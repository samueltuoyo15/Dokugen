# Server Configuration
PORT=3000
NODE_ENV=production
BACKEND_DOMAIN=yourbackendurl

# Gemini Enterprise Agent Platform (formerly Vertex AI)
# OAuth is automatic: point this at your downloaded service-account JSON.
# Keep the JSON outside version control. On Google Cloud, omit this variable and
# use the service account attached to the workload instead.
GOOGLE_APPLICATION_CREDENTIALS=./gen-lang-client-0433803567-a4490f059056.json
OPENAI_BASE_URL=https://aiplatform.googleapis.com/v1/projects/your-google-cloud-project/locations/global/endpoints/openapi
README_MODEL_NAME=google/gemini-3.1-pro-preview
COMMIT_MODEL_NAME=google/gemini-3.1-flash-lite
OG_MODEL_NAME=google/gemini-3.1-flash-lite
CHANGELOG_MODEL_NAME=google/gemini-3.1-flash-lite

# Optional: leave blank for the Agent Platform service account above. Set this
# only when changing OPENAI_BASE_URL to another OpenAI-compatible provider.
OPENAI_API_KEY=

# Supabase Persistence & User Telemetry Tracking (Optional)
SUPABASE_CLIENT_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
