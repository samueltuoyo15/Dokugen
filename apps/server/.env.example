# Server Configuration
PORT=3000
NODE_ENV=production
BACKEND_DOMAIN=https://dokugen.samueltuoyo.com

# DeepSeek (Primary Service for README Generation & Commit Failover)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
README_MODEL_NAME=deepseek-v4-pro
COMMIT_MODEL_NAME=deepseek-v4-flash

# OpenRouter ($0 Zero-Cost Provider for CHANGELOG & Primary AI Commit Messages)
# Get a free key at: https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here
CHANGELOG_MODEL_NAME=openrouter/free
OPENROUTER_COMMIT_MODEL=openrouter/free

# Supabase Persistence & User Telemetry Tracking (Optional)
SUPABASE_CLIENT_URL=your_supabase_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
